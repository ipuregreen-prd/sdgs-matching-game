# Copy to .env for local development; python-dotenv loads this file automatically.
# Use the database connection URL, not the Turso dashboard URL.
# Vercel: set TURSO_AUTH_TOKEN directly in deployment settings.
# Required for first-time cloud initialization. Does not reset existing passwords.
SDGS_ADMIN_PASSWORD=
# Local SQLite only (leave empty when using Turso).
SDGS_DB_PATH=
TURSO_TOKEN_FILE=../deploy/ipuregreen-prd.env
